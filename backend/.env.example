# Worker database and queue
DATABASE_URL=
REDIS_URL=redis://localhost:6379

# External Providers (Phase 2 pipeline)
FIRECRAWL_API_KEY=
PAGESPEED_API_KEY=
DETECTZESTACK_API_KEY=
TAVILY_API_KEY=
SERPAPI_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
RESEND_API_KEY=

# Cloudflare R2 (proposal PDFs + raw snapshots)
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=

# Phase 8 — notify Next.js to send analysis-ready + magic link
WEB_APP_URL=http://localhost:3000
INTERNAL_API_SECRET=

# Runtime
PORT=8080
# Must match web WORKER_WAKE_SECRET when /wake protection is enabled
WORKER_WAKE_SECRET=
NODE_ENV=development
PIPELINE_USE_STUBS=false
