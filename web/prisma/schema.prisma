generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth core tables ───────────────────────────────────────────────

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean   @default(false)
  image           String?
  username        String?   @unique
  displayUsername String?
  role            String    @default("user")
  companyId       String?
  company         Company?  @relation("CompanyMembers", fields: [companyId], references: [id], onDelete: SetNull)
  createdAt       DateTime
  updatedAt       DateTime
  sessions        Session[]
  accounts        Account[]
  leads           Lead[]
  assignedCompanies Company[]      @relation("CompanyAssignee")
  assignedLeads     Lead[]         @relation("LeadAssignee")
  clientConversations Conversation[] @relation("ConversationClient")
  createdConversations Conversation[] @relation("ConversationCreator")
  sentMessages      Message[]
  consultantSessions ConsultantSession[]
  voiceSessions      VoiceSession[]

  @@unique([email])
  @@index([companyId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

// ─── Dashboard / platform data ───────────────────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum ImplementationStatus {
  REQUESTED
  REVIEWING
  SCOPING
  IN_PROGRESS
  DELIVERED
  CLOSED
}

model Company {
  id              String   @id @default(cuid())
  name            String
  domain          String?
  industry        String?
  assignedAdminId String?
  assignedAdmin   User?    @relation("CompanyAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users           User[]   @relation("CompanyMembers")
  leads           Lead[]
  conversations   Conversation[]

  @@index([domain])
  @@index([assignedAdminId])
  @@index([createdAt])
  @@map("company")
}

model Lead {
  id                     String                 @id @default(cuid())
  name                   String
  email                  String
  company                String?
  phone                  String?
  industry               String?
  interest               String?
  message                String?
  notes                  String?
  status                 LeadStatus             @default(NEW)
  implementationStatus   ImplementationStatus?
  source                 String                 @default("contact_form")
  discoveryAnswers       Json?
  metadata               Json?
  userId                 String?
  user                   User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId              String?
  companyRecord          Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedAdminId        String?
  assignedAdmin          User?                  @relation("LeadAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  analyses               Analysis[]
  conversations          Conversation[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([companyId])
  @@index([assignedAdminId])
  @@index([implementationStatus])
  @@map("lead")
}

model Conversation {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation("ConversationClient", fields: [userId], references: [id], onDelete: Cascade)
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User      @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  relatedLeadId     String?
  relatedLead       Lead?     @relation(fields: [relatedLeadId], references: [id], onDelete: SetNull)
  relatedAnalysisId String?
  relatedAnalysis   Analysis? @relation(fields: [relatedAnalysisId], references: [id], onDelete: SetNull)
  lastMessageAt     DateTime  @default(now())
  createdAt         DateTime  @default(now())
  messages          Message[]

  @@index([userId, lastMessageAt])
  @@index([companyId])
  @@index([relatedLeadId])
  @@index([relatedAnalysisId])
  @@index([lastMessageAt])
  @@map("conversation")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  sender         User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@map("message")
}

// ─── Phase 2: Analysis pipeline ────────────────────────────────────────────

enum AnalysisStatus {
  QUEUED
  CRAWLING
  DISCOVERING
  AUDITING
  ANALYZING
  SYNTHESIZING
  PRICING
  GENERATING_PDF
  DONE
  FAILED
}

enum DomainStatus {
  PROCESSING
  COMPLETED
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
}

model AnalyzedDomain {
  id               String       @id @default(cuid())
  normalizedDomain String       @unique
  status           DomainStatus
  lastAnalysisId   String?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())

  @@index([status])
  @@map("analyzed_domain")
}

model Analysis {
  id               String             @id @default(cuid())
  leadId           String
  lead             Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  domain           String
  socialLinks      Json?
  businessIntake   Json?
  guestAccessToken String?            @unique
  emailCapturedAt  DateTime?
  status           AnalysisStatus     @default(QUEUED)
  errorMsg         String?
  createdAt        DateTime           @default(now())
  completedAt      DateTime?
  rawSignals       RawSignal[]
  proposal         Proposal?
  usageLogs        ToolUsageLog[]
  activities       AnalysisActivity[]
  runs             AnalysisRun[]
  consultation     ConsultationMessage[]
  conversations    Conversation[]
  consultantSessions ConsultantSession[]
  voiceSessions    VoiceSession[]
  currentRunId     String?

  @@index([leadId])
  @@index([status])
  @@index([createdAt])
  @@index([guestAccessToken])
  @@map("analysis")
}

model AnalysisRun {
  id           String         @id @default(cuid())
  analysisId   String
  analysis     Analysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  attempt      Int
  status       AnalysisStatus @default(QUEUED)
  coverageJson Json?
  reportJson   Json?
  pricingJson  Json?
  roiJson      Json?
  startedAt    DateTime       @default(now())
  completedAt  DateTime?
  errorMsg     String?
  rawSignals   RawSignal[]
  activities   AnalysisActivity[]
  usageLogs    ToolUsageLog[]
  evidence     AnalysisEvidence[]

  @@unique([analysisId, attempt])
  @@index([analysisId, startedAt])
  @@map("analysis_run")
}

model ConsultationMessage {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  role       String
  content    String
  inputJson  Json?
  createdAt  DateTime @default(now())

  @@index([analysisId, createdAt])
  @@map("consultation_message")
}

model AnalysisEvidence {
  id               String      @id @default(cuid())
  runId            String
  run              AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidenceKey      String
  provider         String
  sourceType       String
  title            String?
  url              String?
  query            String?
  excerpt          String?
  metricPath       String?
  valueJson        Json?
  entityConfidence Float?
  capturedAt       DateTime    @default(now())

  @@unique([runId, evidenceKey])
  @@index([runId, provider])
  @@map("analysis_evidence")
}

model AnalysisActivity {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  runId      String?
  run        AnalysisRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind       String
  message    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([analysisId, createdAt])
  @@index([runId, createdAt])
  @@map("analysis_activity")
}

model RawSignal {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  runId      String?
  run        AnalysisRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  source     String
  payload    Json
  fetchedAt  DateTime @default(now())

  @@index([analysisId])
  @@index([runId])
  @@index([source])
  @@map("raw_signal")
}

model Proposal {
  id                  String         @id @default(cuid())
  analysisId          String         @unique
  analysis            Analysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  strategyJson        Json?
  techStack           Json?
  automationBlueprint Json?
  narrativeText       String?
  costEstimateUSD     Int?
  timelineWeeks       Int?
  pdfUrl              String?
  reportVersion       String         @default("1.0")
  reportJson          Json?
  pricingJson         Json?
  roiJson             Json?
  status              ProposalStatus @default(DRAFT)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("proposal")
}

model ProviderConfig {
  id                 String  @id @default(cuid())
  provider           String  @unique
  // Stored as fractional USD (not integer dollars) — provider calls often
  // cost fractions of a cent, and rounding those up to whole dollars caused
  // budgets to exhaust roughly 100x faster than intended.
  monthlyBudgetUSD   Float
  currentSpendUSD    Float   @default(0)
  rateLimitPerMinute Int     @default(60)
  isEnabled          Boolean @default(false)

  @@map("provider_config")
}

model ToolUsageLog {
  id              String   @id @default(cuid())
  analysisId      String
  analysis        Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  runId           String?
  run             AnalysisRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  provider        String
  endpoint        String
  creditsOrTokens Int      @default(0)
  costEstimateUSD Float    @default(0)
  latencyMs       Int
  status          String
  createdAt       DateTime @default(now())

  @@index([analysisId])
  @@index([runId])
  @@index([provider])
  @@index([createdAt])
  @@map("tool_usage_log")
}

// ─── Phase 5: AI Consultant (chat + Gemini Live voice) ──────────────────────

model ConsultantSession {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId    String
  analysis      Analysis             @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  status        String               @default("ACTIVE")
  createdAt     DateTime             @default(now())
  lastMessageAt DateTime             @default(now())
  messages      ConsultantMessage[]
  voiceSessions VoiceSession[]

  @@unique([userId, analysisId])
  @@index([userId, lastMessageAt])
  @@index([analysisId])
  @@map("consultant_session")
}

model ConsultantMessage {
  id          String            @id @default(cuid())
  sessionId   String
  session     ConsultantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String
  content     String
  modality    String            @default("text")
  toolName    String?
  toolPayload Json?
  createdAt   DateTime          @default(now())

  @@index([sessionId, createdAt])
  @@map("consultant_message")
}

model VoiceSession {
  id                   String            @id @default(cuid())
  consultantSessionId  String
  consultantSession    ConsultantSession @relation(fields: [consultantSessionId], references: [id], onDelete: Cascade)
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId           String
  analysis             Analysis         @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  provider             String           @default("gemini")
  model                String
  status               String            @default("LIVE")
  startedAt            DateTime          @default(now())
  endedAt              DateTime?
  errorMsg             String?

  @@index([userId, startedAt])
  @@index([analysisId])
  @@map("voice_session")
}

// ─── Phase 10: Admin audit trail ───────────────────────────────────────────

model AdminEventLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_event_log")
}
